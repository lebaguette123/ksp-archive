<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:App.ViewModels"
        Title="KSP Archive" Width="1100" Height="650"
        x:Class="App.Views.MainWindow"
        x:DataType="local:MainWindowViewModel"
        Background="{DynamicResource KspBgMain}"
        FontFamily="{DynamicResource KspMonospace}">

    <Grid RowDefinitions="*, Auto">
        <Grid Grid.Row="0" ColumnDefinitions="4*, 6*">

            <!-- ===== Left: source, filters, parts list ===== -->
            <Border Grid.Column="0"
                    Background="{DynamicResource KspBgPanel}"
                    BorderBrush="{DynamicResource KspBorderDark}"
                    BorderThickness="0,0,1,0"
                    Padding="16">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Classes="section" Text="GAMEDATA FOLDER" Margin="0,0,0,8"/>

                    <TextBox Name="PathInput"
                             Classes="field"
                             DockPanel.Dock="Top"
                             PlaceholderText="Paste KSP GameData path..."
                             Text="{Binding GameDataPath, Mode=TwoWay}"
                             Margin="0,0,0,8"/>

                    <Button DockPanel.Dock="Top"
                            Classes="primary"
                            Content="Scan folder"
                            Click="ScanButton_Click"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,22"/>

                    <TextBlock DockPanel.Dock="Top" Classes="section" Text="FILTER" Margin="0,0,0,8"/>

                    <TextBox Classes="field"
                             DockPanel.Dock="Top"
                             PlaceholderText="Search parts by name..."
                             Text="{Binding SearchText, Mode=TwoWay}"
                             Margin="0,0,0,10"/>

                    <ListBox DockPanel.Dock="Top"
                             Classes="chips"
                             ItemsSource="{Binding AvailableCategories}"
                             SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                             Margin="0,0,0,12">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{Binding}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <ListBox Classes="parts"
                             ItemsSource="{Binding Parts}"
                             SelectedItem="{Binding SelectedPart}"
                             Background="{DynamicResource KspBgMain}"
                             BorderBrush="{DynamicResource KspBorderDark}"
                             BorderThickness="1"
                             CornerRadius="2">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Title, FallbackValue='Unknown Part'}"
                                               Foreground="{DynamicResource KspTextLight}"
                                               FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Name, FallbackValue='Pending parse...'}"
                                               Foreground="{DynamicResource KspTextMuted}"
                                               FontSize="11"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ===== Right: selected part ===== -->
            <ScrollViewer Grid.Column="1" Padding="32,28" Background="{DynamicResource KspBgDeep}">
                <StackPanel IsVisible="{Binding SelectedPart, Converter={x:Static ObjectConverters.IsNotNull}}">

                    <TextBlock Classes="title" Text="{Binding SelectedPart.Title, FallbackValue=''}"/>
                    <TextBlock Classes="label mono"
                               Text="{Binding SelectedPart.FilePath, FallbackValue=''}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,4,0,18"/>
                    <TextBlock Classes="body"
                               Text="{Binding SelectedPart.Description, FallbackValue='No description found.'}"
                               Margin="0,0,0,24"/>

                    <Border Classes="rule" Margin="0,0,0,24"/>

                    <TextBlock Classes="section" Text="OVERVIEW"/>
                    <WrapPanel Margin="0,0,0,28">
                        <StackPanel Margin="0,0,36,12">
                            <TextBlock Classes="label" Text="MASS"/>
                            <TextBlock Classes="value" Margin="0,4,0,0"
                                       Text="{Binding SelectedPart.Mass, FallbackValue=0, StringFormat='\{0:0.###\} t'}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,36,12">
                            <TextBlock Classes="label" Text="COST"/>
                            <TextBlock Classes="value" Margin="0,4,0,0"
                                       Text="{Binding SelectedPart.Cost, FallbackValue=0, StringFormat='\{0:N0\} funds'}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,36,12">
                            <TextBlock Classes="label" Text="CATEGORY"/>
                            <TextBlock Classes="value" Margin="0,4,0,0"
                                       Text="{Binding SelectedPart.Category, FallbackValue='Uncategorized'}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Classes="label" Text="SOURCE"/>
                            <TextBlock Classes="value" Margin="0,4,0,0"
                                       Text="{Binding SelectedPart.ModOrigin, FallbackValue=''}"/>
                        </StackPanel>
                    </WrapPanel>

                    <StackPanel IsVisible="{Binding SelectedPart.HasImportantSpecs, FallbackValue=False}" Margin="0,0,0,28">
                        <TextBlock Classes="section" Text="KEY SPECS"/>
                        <ItemsControl ItemsSource="{Binding SelectedPart.ImportantSpecs, FallbackValue={x:Null}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="card" Width="200" Margin="0,0,10,10">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding Group}"
                                                       FontSize="9" FontWeight="SemiBold" LetterSpacing="0.8"
                                                       Foreground="{DynamicResource KspTextMuted}"/>
                                            <TextBlock Text="{Binding Label}"
                                                       FontSize="10" FontWeight="Medium"
                                                       Foreground="{DynamicResource KspTextLabel}"/>
                                            <TextBlock Classes="value mono" FontSize="15" Margin="0,2,0,0"
                                                       Text="{Binding Value}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <TextBlock Classes="section" Text="RESOURCES"/>
                    <ItemsControl ItemsSource="{Binding SelectedPart.Resources, FallbackValue={x:Null}}" Margin="0,0,0,28">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,14">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                   Foreground="{DynamicResource KspTextLight}"
                                                   FontSize="13" FontWeight="Medium"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="{Binding Amount, StringFormat='\{0:0.\}'}"
                                                       Foreground="{DynamicResource KspTextLight}" FontSize="13"/>
                                            <TextBlock Text=" / " Foreground="{DynamicResource KspTextMuted}" FontSize="13"/>
                                            <TextBlock Text="{Binding MaxAmount, StringFormat='\{0:0.\}'}"
                                                       Foreground="{DynamicResource KspTextMuted}" FontSize="13"/>
                                        </StackPanel>
                                    </Grid>
                                    <ProgressBar Classes="slim"
                                                 Maximum="{Binding MaxAmount}"
                                                 Value="{Binding Amount}"
                                                 Margin="0,6,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Classes="section" Text="MODULES"/>
                    <ItemsControl ItemsSource="{Binding SelectedPart.Modules, FallbackValue={x:Null}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="card" Padding="16,14" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid ColumnDefinitions="*, Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                       Foreground="{DynamicResource KspTextLight}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Classes="label"
                                                       Text="{Binding Fields.Count, StringFormat='{}{0} fields'}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>

                                        <Expander Header="Raw configuration"
                                                  Background="Transparent" BorderThickness="0"
                                                  Foreground="{DynamicResource KspTextMuted}"
                                                  FontSize="11" FontWeight="Medium"
                                                  Padding="0" Margin="0,8,0,0"
                                                  HorizontalAlignment="Stretch">
                                            <ItemsControl ItemsSource="{Binding Fields}" Margin="4,10,4,4">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnDefinitions="*, Auto" Margin="0,3">
                                                            <TextBlock Grid.Column="0" Text="{Binding Key}"
                                                                       Foreground="{DynamicResource KspTextMuted}"
                                                                       FontSize="12" HorizontalAlignment="Left"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                                       Foreground="{DynamicResource KspTextLight}"
                                                                       FontSize="12" HorizontalAlignment="Right"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ===== Status bar ===== -->
        <Border Grid.Row="1"
                Background="{DynamicResource KspBgDeep}"
                BorderBrush="{DynamicResource KspBorderDark}"
                BorderThickness="0,1,0,0"
                Padding="16,8">
            <TextBlock Text="{Binding StatusText}"
                       Foreground="{DynamicResource KspTextLabel}"
                       FontSize="11"/>
        </Border>
    </Grid>
</Window>
