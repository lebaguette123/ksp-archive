<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:App.ViewModels"
        Title="KSP ARCHIVE // DATA SYSTEMS" Width="1100" Height="650"
        x:Class="App.Views.MainWindow"
        x:DataType="local:MainWindowViewModel"
        Background="{DynamicResource KspBgMain}"
        FontFamily="{DynamicResource KspMonospace}">
    
    <Grid RowDefinitions="*, Auto"> 
        <Grid Grid.Row="0" ColumnDefinitions="4*, 6*">
            
            <Border Grid.Column="0" Background="{DynamicResource KspBgPanel}" BorderBrush="{DynamicResource KspBorderDark}" BorderThickness="0,0,2,0" Padding="14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="KSP ENVIRONMENT SETTINGS" FontSize="11" FontWeight="Heavy" LetterSpacing="1" Foreground="{DynamicResource KspCyan}" Margin="2,0,0,6"/>
                    
                    <TextBox Name="PathInput" 
                             DockPanel.Dock="Top"
                             PlaceholderText="Paste KSP GameData path..."
                             Text="{Binding GameDataPath, Mode=TwoWay}"
                             Background="{DynamicResource KspBgDeep}" Foreground="White"
                             BorderBrush="{DynamicResource KspBorderLight}" CornerRadius="2"
                             Margin="0,0,0,6" Padding="10,8"/>
                    
                    <Button DockPanel.Dock="Top"
                            Content="SCAN FILE"
                            Click="ScanButton_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Background="{DynamicResource KspOrange}" Foreground="White"
                            FontWeight="Bold" FontSize="12" LetterSpacing="0.5" CornerRadius="2"
                            Margin="0,0,0,16" Padding="12,10"/>
                    
                    <TextBlock DockPanel.Dock="Top" Text="FILTER ARCHIVES" FontSize="11" FontWeight="Heavy" LetterSpacing="1" Foreground="{DynamicResource KspCyan}" Margin="2,0,0,6"/>
                    
                    <TextBox DockPanel.Dock="Top"
                             PlaceholderText="Search systems by signature..."
                             Text="{Binding SearchText, Mode=TwoWay}"
                             Background="{DynamicResource KspBgDeep}" Foreground="White"
                             BorderBrush="{DynamicResource KspBorderLight}" CornerRadius="2"
                             Margin="0,0,0,8" Padding="10,8"/>

                    <ItemsControl DockPanel.Dock="Top" 
                                  ItemsSource="{Binding AvailableCategories}"
                                  Margin="0,0,0,12">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Stretch"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Button Content="{Binding}" 
                                        Command="{Binding $parent[Window].((local:MainWindowViewModel)DataContext).ChangeCategory, FallbackValue={x:Null}}"
                                        CommandParameter="{Binding}"
                                        FontSize="10" FontWeight="Heavy" CornerRadius="2"
                                        Padding="8,5" Margin="0,0,4,4"
                                        Background="{DynamicResource KspBgChip}" Foreground="{DynamicResource KspTextLabel}"
                                        BorderBrush="{DynamicResource KspBorderLight}" BorderThickness="1"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ListBox ItemsSource="{Binding Parts}" 
                             SelectedItem="{Binding SelectedPart}"
                             Background="{DynamicResource KspBgMain}" BorderBrush="{DynamicResource KspBorderDark}" BorderThickness="1" CornerRadius="2">
                        
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,6">
                                    <TextBlock Text="{Binding Title, FallbackValue='Unknown Part'}" Foreground="White" FontWeight="Bold" FontSize="13"/>
                                    <TextBlock Text="{Binding Name, FallbackValue='Pending parse...'}" FontSize="11" Foreground="{DynamicResource KspTextMuted}" FontFamily="Consolas, monospace"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Column="1" Padding="30" Background="{DynamicResource KspBgDeep}">
                <StackPanel IsVisible="{Binding SelectedPart, Converter={x:Static ObjectConverters.IsNotNull}}">
                    
                    <TextBlock Text="{Binding SelectedPart.Title, FallbackValue=''}" FontSize="24" FontWeight="Black" Foreground="{DynamicResource KspTextLight}" LetterSpacing="-0.5"/>
                    <TextBlock Text="{Binding SelectedPart.FilePath, FallbackValue=''}" FontSize="11" Foreground="{DynamicResource KspTextMuted}" FontFamily="Consolas, monospace" Margin="0,4,0,20"/>
                    <TextBlock Text="{Binding SelectedPart.Description, FallbackValue='No description found.'}" Foreground="{DynamicResource KspTextLabel}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,20" LineHeight="18"/>
                    
                    <Border Height="2" Background="{DynamicResource KspCyan}" Margin="0,0,0,25"/>

                    <TextBlock Text="CORE SPECIFICATIONS" FontSize="12" FontWeight="Heavy" LetterSpacing="1" Foreground="{DynamicResource KspCyan}" Margin="0,0,0,12"/>
                    <Grid ColumnDefinitions="Auto, Auto, Auto, *" RowDefinitions="Auto" Margin="0,0,0,30">
                        <StackPanel Grid.Column="0" Margin="0,0,30,0">
                            <TextBlock Text="TOTAL MASS" FontSize="10" Foreground="{DynamicResource KspTextMuted}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding SelectedPart.Mass, FallbackValue=0, StringFormat='\{0:0.###\} t'}" Foreground="{DynamicResource KspTextLight}" FontSize="18" FontWeight="Black" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,30,0">
                            <TextBlock Text="ASSET VALUE" FontSize="10" Foreground="{DynamicResource KspTextMuted}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding SelectedPart.Cost, FallbackValue=0, StringFormat='\{0\}  FUNDS'}" Foreground="{DynamicResource KspOrange}" FontSize="18" FontWeight="Black" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="DESIGNATION CLASS" FontSize="10" Foreground="{DynamicResource KspTextMuted}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding SelectedPart.Category, FallbackValue='UNCATEGORIZED'}" Foreground="{DynamicResource KspCyan}" FontSize="18" FontWeight="Black" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="INTERNAL RESOURCE STORAGE" FontSize="12" FontWeight="Heavy" LetterSpacing="1" Foreground="{DynamicResource KspCyan}" Margin="0,0,0,12"/>
                    <ListBox ItemsSource="{Binding SelectedPart.Resources, FallbackValue={x:Null}}" Background="Transparent" BorderThickness="0" Margin="0,0,0,30">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,12">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="White" FontWeight="Bold" FontSize="13" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="{Binding Amount, StringFormat='\{0:0.\}'}" Foreground="White" FontWeight="Bold"/>
                                            <TextBlock Text=" / " Foreground="{DynamicResource KspTextMuted}"/>
                                            <TextBlock Text="{Binding MaxAmount, StringFormat='\{0:0.\}'}" Foreground="{DynamicResource KspTextMuted}"/>
                                        </StackPanel>
                                    </Grid>
                                    <ProgressBar Maximum="{Binding MaxAmount}" Value="{Binding Amount}" Height="8" Background="{DynamicResource KspBgDeep}" Foreground="{DynamicResource KspCyan}" CornerRadius="1" Margin="0,6,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel IsVisible="{Binding SelectedPart.HasImportantSpecs, FallbackValue=False}" Margin="0,0,0,30">
                        <TextBlock Text="SUBSYSTEM DIAGNOSTICS" FontSize="12" FontWeight="Heavy" LetterSpacing="1" Foreground="{DynamicResource KspCyan}" Margin="0,0,0,12"/>
                        <ItemsControl ItemsSource="{Binding SelectedPart.ImportantSpecs, FallbackValue={x:Null}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource KspBgPanel}" BorderBrush="{DynamicResource KspBorderDark}" BorderThickness="1" CornerRadius="2" Padding="14,12" Margin="0,0,10,10" Width="210">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Group}" FontSize="9" Foreground="{DynamicResource KspTextMuted}" FontWeight="Heavy" LetterSpacing="0.5"/>
                                            <TextBlock Text="{Binding Label}" FontSize="10" Foreground="{DynamicResource KspTextLight}" FontWeight="Bold" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding Value}" FontSize="16" Foreground="{DynamicResource KspTextLight}" FontWeight="Black" Margin="0,4,0,0" FontFamily="Consolas, monospace"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <TextBlock Text="FUNCTIONAL ARCHITECTURE MODULES" FontSize="12" FontWeight="Heavy" LetterSpacing="1" Foreground="{DynamicResource KspCyan}" Margin="0,0,0,12"/>
                    <ListBox ItemsSource="{Binding SelectedPart.Modules, FallbackValue={x:Null}}" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource KspBgPanel}" BorderBrush="{DynamicResource KspBorderDark}" BorderThickness="1" CornerRadius="2" Padding="16" Margin="0,0,0,10">
                                    <StackPanel>
                                        
                                        <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,12">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" FontWeight="Black" Foreground="{DynamicResource KspCyan}" FontSize="14"/>
                                                <TextBlock Text="ACTIVE SUBSYSTEM EMULATION" FontSize="10" Foreground="{DynamicResource KspTextMuted}" FontWeight="Bold" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{DynamicResource KspBgDeep}" CornerRadius="2" Padding="8,4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Fields.Count, StringFormat='{}{0} DATA FIELDS'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource KspTextLight}"/>
                                            </Border>
                                        </Grid>

                                        <Expander Header="VIEW RAW CONFIGURATION" 
                                                  Background="Transparent" BorderThickness="0" 
                                                  Foreground="{DynamicResource KspTextMuted}" FontSize="11" FontWeight="Bold" 
                                                  Padding="0" HorizontalAlignment="Stretch">
                                            <ItemsControl ItemsSource="{Binding Fields}" Margin="4,12,4,4">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnDefinitions="*, Auto" Margin="0,4">
                                                            <TextBlock Grid.Column="0" Text="{Binding Key}" Foreground="{DynamicResource KspTextMuted}" FontSize="12" HorizontalAlignment="Left"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{DynamicResource KspTextLight}" FontSize="12" HorizontalAlignment="Right" FontFamily="Consolas, monospace"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>

                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource KspBgDeep}" BorderBrush="{DynamicResource KspBorderLight}" BorderThickness="0,2,0,0" Padding="14,8">
            <Grid ColumnDefinitions="*, Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" Foreground="{DynamicResource KspCyan}" FontSize="11" FontWeight="Bold" LetterSpacing="0.5"/>
                <TextBlock Grid.Column="1" Text="SYS_STATUS // ONLINE" Foreground="{DynamicResource KspTextMuted}" FontSize="11" FontWeight="Bold"/>
            </Grid>
        </Border>
    </Grid>
</Window>
