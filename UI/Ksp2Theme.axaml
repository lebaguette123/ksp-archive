<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="KspMonospace">Consolas, DejaVu Sans Mono, Courier New, monospace</FontFamily>

    <SolidColorBrush x:Key="KspBgDeep" Color="#111416"/>
    <SolidColorBrush x:Key="KspBgMain" Color="#161A1D"/>
    <SolidColorBrush x:Key="KspBgPanel" Color="#1B2023"/>
    <SolidColorBrush x:Key="KspBgChip" Color="#242A2E"/>
    <SolidColorBrush x:Key="KspBgRaised" Color="#2C3338"/>
    <SolidColorBrush x:Key="KspBorderDark" Color="#2A3136"/>
    <SolidColorBrush x:Key="KspBorderLight" Color="#38414A"/>
    <SolidColorBrush x:Key="KspTextMuted" Color="#7C8A94"/>
    <SolidColorBrush x:Key="KspTextLabel" Color="#A0AAB2"/>
    <SolidColorBrush x:Key="KspTextLight" Color="#E5E5EA"/>

    <!-- Accent: selected / active / focused, plus data bars -->
    <SolidColorBrush x:Key="KspAccent" Color="#4FAFC0"/>
    <SolidColorBrush x:Key="KspAccentDim" Color="#15292F"/>

    <!-- Action: the one primary button -->
    <SolidColorBrush x:Key="KspAction" Color="#D9622B"/>
    <SolidColorBrush x:Key="KspActionHover" Color="#E5733C"/>

    <!-- Warning: flagged values (not used yet) -->
    <SolidColorBrush x:Key="KspWarn" Color="#D4A24A"/>
</ResourceDictionary>